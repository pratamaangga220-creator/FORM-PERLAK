// Sections that carry a page-number footer in the template (the agreement body).
const NUMBERED_SECTIONS=1;
// Split one rendered section into page-sized slices at line/row boundaries.
function planPages(s){
  const cs=getComputedStyle(s), sr=s.getBoundingClientRect();
  const padTop=parseFloat(cs.paddingTop)||0, padBottom=parseFloat(cs.paddingBottom)||0, padRight=parseFloat(cs.paddingRight)||0;
  const pageW=s.offsetWidth;
  let pageH=parseFloat(s.style.minHeight)?0:0;
  const mh=cs.minHeight; const tmp=document.createElement("div"); tmp.style.height=mh; tmp.style.position="absolute"; s.appendChild(tmp); pageH=tmp.offsetHeight; tmp.remove();
  if(!pageH||pageH<200) pageH=Math.round(pageW*1.4142);
  const avail=pageH-padTop-padBottom;
  const boxes=[];
  const tw=document.createTreeWalker(s,NodeFilter.SHOW_TEXT);
  const rg=document.createRange();
  while(tw.nextNode()){
    const n=tw.currentNode; if(!n.nodeValue.trim()) continue;
    rg.selectNodeContents(n);
    for(const r of rg.getClientRects()){ if(r.height>0) boxes.push([r.top-sr.top,r.bottom-sr.top]); }
  }
  s.querySelectorAll("img,svg,tr").forEach(el=>{ const r=el.getBoundingClientRect(); if(r.height>0 && r.height<avail) boxes.push([r.top-sr.top,r.bottom-sr.top]); });
  if(!boxes.length) return {slices:[],pageW,pageH,padTop,padBottom,padRight};
  boxes.sort((x,y)=>x[0]-y[0]);
  const end=Math.max(...boxes.map(b=>b[1]))+2;
  const valid=y=>!boxes.some(b=>b[0]<y-0.5&&b[1]>y+0.5);
  const cands=[...new Set(boxes.map(b=>Math.ceil(b[1]+1)))].sort((a,b)=>a-b);
  const slices=[]; let start=padTop, guard=0;
  while(start<end-1 && guard++<200){
    const limit=start+avail;
    if(limit>=end){ slices.push([start,end]); break; }
    let cut=null;
    for(const y of cands){ if(y>limit) break; if(y>start+avail*0.3 && valid(y)) cut=y; }
    if(cut===null) cut=limit;
    slices.push([start,cut]);
    const next=boxes.find(b=>b[0]>=cut-0.5);
    start = next && next[0]-cut<avail*0.25 ? Math.max(cut,Math.floor(next[0]-2)) : cut;
  }
  return {slices,pageW,pageH,padTop,padBottom,padRight};
}
