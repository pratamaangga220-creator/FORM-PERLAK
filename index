try{ remote=JSON.parse(localStorage.getItem("pks_ppk_remote")||"null"); }catch(e){}
function remoteOn(){ return LOCAL && remote && remote.url && remote.key; }
function jsonp(url){
  return new Promise((res,rej)=>{
    const cb="__ppk"+Date.now()+Math.floor(Math.random()*1e4);
    const s=document.createElement("script"); let done=false;
    const t=setTimeout(()=>{ if(!done){ done=true; cleanup(); rej(new Error("Tidak ada jawaban dari Web App")); } },20000);
    function cleanup(){ clearTimeout(t); delete window[cb]; s.remove(); }
    window[cb]=d=>{ if(done) return; done=true; cleanup(); res(d); };
    s.onerror=()=>{ if(done) return; done=true; cleanup(); rej(new Error("Web App tidak bisa dihubungi")); };
    s.src=url+(url.includes("?")?"&":"?")+"callback="+cb;
    document.head.appendChild(s);
  });
}
let rTimer=null, rSeq=0;
async function remoteSearch(){
  const q=$("q").value.trim(); const box=$("lkList");
  if(q.replace(/\s+/g,"").length<4){ box.hidden=true; lkItems=[]; lkStatus(q?"Ketik minimal 4 karakter.":"Terhubung ke Google Sheets lewat Web App. Ketik No Keluhan atau nama.", q?"":"ok"); return; }
  const seq=++rSeq; lkStatus("Mencari di Google Sheets…");
  const url=remote.url+"?key="+encodeURIComponent(remote.key)+"&q="+encodeURIComponent(q);
  let d;
  try{ const r=await fetch(url,{redirect:"follow"}); d=await r.json(); }
  catch(e){ try{ d=await jsonp(url); }catch(e2){ if(seq===rSeq) lkStatus(e2.message+". Cek URL Web App dan akses 'Anyone'.","bad"); return; } }
  if(seq!==rSeq) return;
  if(!d||!d.ok){ lkStatus((d&&d.error)||"Jawaban Web App tidak dikenali.","bad"); box.hidden=true; return; }
  ppkShow(d.rows||[]);
  lkStatus((d.rows||[]).length+" hasil dari Google Sheets.","ok");
}
function ppkShow(items){
