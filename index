async function drawOn(zip,path,fn){
  const f=zip.file(path); if(!f) return;
  const blob=new Blob([await f.async("arraybuffer")],{type:"image/jpeg"});
  const bmp=await createImageBitmap(blob);
  const c=document.createElement("canvas"); c.width=bmp.width; c.height=bmp.height;
  const g=c.getContext("2d"); g.drawImage(bmp,0,0); fn(g);
  const out=await new Promise(r=>c.toBlob(r,"image/jpeg",0.9));
  zip.file(path,await out.arrayBuffer());
}

// ---- docx fill
let tplBuf=null;
function tplBytes(){
  if(!tplBuf){ const b64=$("tplData").textContent.trim(); const bin=atob(b64); const u=new Uint8Array(bin.length); for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i); tplBuf=u; }
  return tplBuf;
}
async function fillDocx(vals,forPreview){
  const zip=await JSZip.loadAsync(tplBytes());
  let xml=await zip.file("word/document.xml").async("string");
