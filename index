<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Form PKS PERLAK</title><meta name="description" content="Form pengisian Perjanjian PERLAK beserta Lampiran Notulen RAB dan BA Kesepakatan, ULP Kuta."><meta name="robots" content="noindex,nofollow"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%230f6c86'/%3E%3Cpath d='M9 7h10l5 5v13H9z' fill='white'/%3E%3Cpath d='M12 16h9M12 20h9M12 12h5' stroke='%230f6c86' stroke-width='1.8'/%3E%3C/svg%3E"><style>html,body{margin:0}[hidden]{display:none!important}body{font-size:14px}</style></head><body>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400;0,700;1,400;1,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: alat kerja dua kolom — form isian di kiri, pratinjau halaman dokumen di kanan; riwayat unduhan di bawah. */
:root{
  --bg:#f3f5f6; --surface:#ffffff; --ink:#18232b; --muted:#5b6b75; --line:#d6dde1;
  --accent:#0f6c86; --accent-ink:#ffffff; --accent-soft:#e2f0f4;
  --red:#c62020; --ok:#1d7a46; --warn:#9a6400; --paper-shadow:0 1px 3px rgba(20,40,50,.18);
  --f-ui:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#11181c; --surface:#192329; --ink:#e3eaee; --muted:#93a4ad; --line:#2c3a42;
  --accent:#4fb3cf; --accent-ink:#06222b; --accent-soft:#183540;
  --red:#ff7272; --ok:#5fcf8e; --warn:#e6b34d; --paper-shadow:0 1px 4px rgba(0,0,0,.6); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#11181c; --surface:#192329; --ink:#e3eaee; --muted:#93a4ad; --line:#2c3a42;
  --accent:#4fb3cf; --accent-ink:#06222b; --accent-soft:#183540;
  --red:#ff7272; --ok:#5fcf8e; --warn:#e6b34d; --paper-shadow:0 1px 4px rgba(0,0,0,.6); color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--ink);font-family:var(--f-ui);font-size:14px;line-height:1.5}
.wrap{max-width:1280px;margin:0 auto;padding:20px 16px 48px;display:flex;flex-direction:column;gap:20px}
header.top{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 16px}
h1{font-size:20px;margin:0;font-weight:600;letter-spacing:-.01em;text-wrap:balance}
.sub{color:var(--muted);margin:2px 0 0;font-size:13px}
.tag{font-family:var(--f-mono);font-size:12px;color:var(--muted);border:1px solid var(--line);padding:2px 8px;border-radius:4px}
.grid{display:grid;grid-template-columns:minmax(0,400px) minmax(0,1fr);gap:20px;align-items:start}
@media (max-width:900px){.grid{grid-template-columns:minmax(0,1fr)}}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:8px;min-width:0}
.panel>.hd{padding:12px 16px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}
.panel>.hd h2{font-size:14px;font-weight:600;margin:0}
.panel>.bd{padding:16px}
form{display:flex;flex-direction:column;gap:14px}
fieldset{border:0;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
legend{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding:0;margin-bottom:10px}
.row2{display:grid;grid-template-columns:minmax(0,110px) minmax(0,1fr);gap:8px}
.row-half{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px}
label.f{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:500;min-width:0}
label.f .hint{font-weight:400;color:var(--muted);font-size:12px}
.req::after{content:" *";color:var(--red)}
input[type=text],input[type=tel],input[type=date],select{font:inherit;font-size:14px;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:8px 10px;width:100%;min-width:0}
input.mono{font-family:var(--f-mono)}
input:focus-visible,select:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
input[aria-invalid=true]{border-color:var(--red)}
input:disabled{opacity:.6}
.chk{display:flex;gap:6px;align-items:center;font-size:12px;color:var(--muted);font-weight:400}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--red);margin-right:6px;vertical-align:1px}
.note{font-size:12px;color:var(--muted);margin:0}
.err{font-size:13px;color:var(--red);margin:0}
.btns{display:flex;gap:8px;flex-wrap:wrap}
button{font:inherit;font-weight:500;border-radius:6px;padding:9px 14px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}
button.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
button:disabled{opacity:.5;cursor:not-allowed}
button:not(:disabled):hover{filter:brightness(1.06)}
.status{font-size:13px;color:var(--muted);min-height:20px}
.status.ok{color:var(--ok)} .status.bad{color:var(--red)} .status.warn{color:var(--warn)}
.tabs{display:flex;gap:0;border-bottom:1px solid var(--line);padding:0 8px;overflow-x:auto}
.tabs button{border:0;border-bottom:2px solid transparent;border-radius:0;background:none;padding:10px 10px 8px;color:var(--muted);font-size:13px;white-space:nowrap}
.tabs button[aria-selected=true]{color:var(--ink);border-bottom-color:var(--accent);font-weight:600}
.tsub{display:block;font-size:10px;font-family:var(--f-mono);font-weight:400;color:var(--muted)}
.pane{display:flex;flex-direction:column;gap:14px}
.auto{font-size:12px;color:var(--muted);background:var(--accent-soft);padding:8px 10px;border-radius:6px;margin:0}
textarea{font:inherit;font-size:14px;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:8px 10px;width:100%;resize:vertical}
.total{display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding:8px 10px;border:1px solid var(--line);border-radius:6px}
.total span{color:var(--muted);font-size:13px}
.checks{display:flex;flex-direction:column;gap:2px}
.ck{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:8px;align-items:center;padding:5px 0;border-bottom:1px solid var(--line);font-size:13px}
.ck:last-child{border-bottom:0}
.ck .no{font-family:var(--f-mono);font-size:11px;color:var(--muted)}
.ck select{width:auto;padding:4px 6px;font-size:13px}
.ck .fixed{font-size:12px;color:var(--muted);font-family:var(--f-mono)}
.seg{display:flex;flex-wrap:wrap;gap:6px}
.seg label{display:flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:6px;padding:6px 10px;font-size:13px;cursor:pointer}
.seg label:has(input:checked){border-color:var(--accent);background:var(--accent-soft)}
.lookup{padding:12px 16px;border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:6px;background:var(--accent-soft)}
.lk-label{font-size:13px;font-weight:600;display:flex;flex-direction:column;gap:2px}
.lk-label .hint{font-weight:400;color:var(--muted);font-size:12px}
.lk-row{display:flex;gap:6px}
.lk-row input{flex:1;min-width:0;font:inherit;font-family:var(--f-mono);font-size:14px;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:8px 10px}
.lk-row button{white-space:nowrap;padding:8px 10px;font-size:13px}
.lk-status{margin:0;font-size:12px;color:var(--muted)}
.lk-status.bad{color:var(--red)} .lk-status.ok{color:var(--ok)}
.lk-list{list-style:none;margin:0;padding:0;border:1px solid var(--line);border-radius:6px;background:var(--surface);max-height:260px;overflow:auto}
.lk-list li{padding:7px 10px;border-bottom:1px solid var(--line);cursor:pointer;display:flex;flex-direction:column;gap:1px}
.lk-list li:last-child{border-bottom:0}
.lk-list li[aria-selected=true],.lk-list li:hover{background:var(--accent-soft)}
.lk-list .l1{font-family:var(--f-mono);font-size:12px}
.lk-list .l2{font-size:13px;font-weight:500}
.lk-list .l3{font-size:11px;color:var(--muted)}
.lk-card{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:10px 12px;display:flex;flex-direction:column;gap:6px;font-size:12px}
.lk-card .top{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;align-items:baseline}
.lk-card .top b{font-size:13px}
.lk-card dl{display:grid;grid-template-columns:auto minmax(0,1fr);gap:2px 10px;margin:0}
.lk-card dt{color:var(--muted)} .lk-card dd{margin:0;overflow-wrap:anywhere}
.chip{font-family:var(--f-mono);font-size:11px;padding:1px 6px;border-radius:4px;border:1px solid var(--line);white-space:nowrap}
.chip.bad{color:var(--red);border-color:var(--red)} .chip.ok{color:var(--ok);border-color:var(--ok)}
.lk-warn{margin:0;color:var(--warn);font-size:12px}
.rab-hint{font-size:12px;margin:0}
.rab-hint.warn{color:var(--warn)}
.lk-set{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:10px 12px;display:flex;flex-direction:column;gap:8px}
/* preview */
.pv-empty{padding:40px 16px;text-align:center;color:var(--muted)}
.pv-empty b{color:var(--ink);font-weight:600;display:block;margin-bottom:4px}
.pages{display:flex;flex-direction:column;gap:14px;align-items:center;padding:16px;max-height:80vh;overflow:auto;background:var(--bg);border-radius:0 0 8px 8px}
.pages figure{margin:0;width:100%;max-width:720px}
.pages img{display:block;width:100%;height:auto;background:#fff;box-shadow:var(--paper-shadow)}
.pages figcaption{font-family:var(--f-mono);font-size:11px;color:var(--muted);text-align:center;margin-top:4px}
.summary{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 12px;font-size:13px;margin:0}
.summary dt{color:var(--muted)} .summary dd{margin:0;font-weight:500;overflow-wrap:anywhere}
.stale{background:var(--accent-soft);color:var(--ink);padding:8px 12px;border-radius:6px;font-size:13px}
/* table */
.tbl-wrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:13px;font-variant-numeric:tabular-nums}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);white-space:nowrap;vertical-align:top}
th{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:600;background:var(--surface);position:sticky;top:0}
td.mono{font-family:var(--f-mono);font-size:12px}
td.wrapc{white-space:normal;min-width:160px}
.pill{font-size:11px;font-family:var(--f-mono);padding:1px 6px;border-radius:4px;border:1px solid var(--line)}
.count{font-family:var(--f-mono);font-size:12px;color:var(--muted)}
/* hidden renderer for docx -> pages */
#renderHost{position:absolute;left:0;top:0;width:1000px;pointer-events:none;z-index:-1;opacity:0;overflow:hidden;height:0}
#renderHost.active{height:auto}
.docx-render [style*="Arial"]{font-family:Arimo,Arial,"Liberation Sans",sans-serif !important}
.docx-render section.docx{font-family:Arimo,Arial,"Liberation Sans",sans-serif}
.docx-render .docx-wrapper{background:#fff !important;padding:0 !important;display:block !important}
.docx-render .docx-wrapper>section.docx{margin:0 0 20px 0 !important;box-shadow:none !important}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<div class="wrap">
  <header class="top">
    <div>
      <h1>Form PKS PERLAK</h1>
      <p class="sub">Perjanjian Pekerjaan Pembongkaran/Perbaikan/Penggeseran/Perubahan Aset — ULP Kuta</p>
    </div>
    <span class="tag">Template: PKS + Lampiran I–II</span>
  </header>

  <div class="grid">
    <section class="panel" aria-labelledby="h-form">
      <div class="hd"><h2 id="h-form">Data dokumen</h2><span class="note">Kosongkan isian yang akan ditulis tangan</span></div>
      <div class="lookup">
        <label for="q" class="lk-label">Cari No Keluhan <span class="hint">No Laporan atau nama pemohon dari data PPK</span></label>
        <div class="lk-row">
          <input type="search" id="q" class="mono" autocomplete="off" placeholder="K5526… / 5512… / nama" aria-controls="lkList" aria-autocomplete="list">
          <button type="button" id="btnSrc">Muat data</button>
          <input type="file" id="fileSrc" accept=".csv,.xlsx,.xls" hidden>
          <button type="button" id="btnSet" hidden aria-label="Pengaturan sumber data" title="Sambungkan ke Google Sheets">⚙</button>
        </div>
        <div class="lk-set" id="lkSet" hidden>
          <p class="note">Sambungkan langsung ke Google Sheets lewat Apps Script Web App (lihat panduan). Isian ini disimpan di browser ini.</p>
          <label class="f">URL Web App<input type="url" id="rUrl" class="mono" placeholder="https://script.google.com/macros/s/…/exec" autocomplete="off"></label>
          <label class="f">Kode akses<input type="text" id="rKey" class="mono" autocomplete="off"></label>
          <div class="btns"><button type="button" class="primary" id="btnSaveSet">Simpan</button><button type="button" id="btnClearSet">Hapus sambungan</button></div>
        </div>
        <p class="lk-status" id="lkStatus"></p>
        <ul class="lk-list" id="lkList" role="listbox" hidden></ul>
        <div class="lk-card" id="lkCard" hidden></div>
      </div>
      <div class="tabs" role="tablist" aria-label="Bagian dokumen">
        <button type="button" role="tab" id="tab-pks" aria-controls="pane-pks" aria-selected="true">Perjanjian</button>
        <button type="button" role="tab" id="tab-not" aria-controls="pane-not" aria-selected="false" tabindex="-1">Notulen RAB <span class="tsub">Lamp. II-A</span></button>
        <button type="button" role="tab" id="tab-bak" aria-controls="pane-bak" aria-selected="false" tabindex="-1">BA Kesepakatan <span class="tsub">Lamp. II-B</span></button>
      </div>
      <div class="bd">
        <form id="frm" novalidate>
         <div class="pane" id="pane-pks" role="tabpanel" aria-labelledby="tab-pks">
          <fieldset>
            <legend>Pemohon</legend>
            <div class="row2">
              <label class="f">Sapaan
                <select id="sapaan"><option>Bapak</option><option>Ibu</option><option>Saudara</option><option value="">(tanpa)</option></select>
              </label>
              <label class="f"><span class="req">Nama pemohon</span>
                <input type="text" id="nama" autocomplete="off" placeholder="Kevin">
              </label>
            </div>
            <label class="f"><span class="req">Alamat</span> <span class="hint">Dipakai juga di korespondensi, Notulen, dan BA Kesepakatan</span>
              <input type="text" id="alamat" autocomplete="off" placeholder="Jl Beraban">
            </label>
            <div class="row-half">
              <label class="f"><span class="req">No. telepon</span>
                <input type="tel" id="telp" class="mono" autocomplete="off" placeholder="0881xxxxxxx">
              </label>
              <label class="f">No. KTP/SIM/Paspor
                <input type="text" id="ktp" class="mono" autocomplete="off" placeholder="kosong = titik-titik">
              </label>
            </div>
          </fieldset>
          <fieldset>
            <legend>Nomor &amp; tanggal</legend>
            <label class="f"><span class="req">Nomor PLN</span>
              <input type="text" id="noPln" class="mono" autocomplete="off" placeholder="K55260920000xx">
            </label>
            <div class="row-half">
              <label class="f"><span class="req">No. surat permohonan</span>
                <input type="text" id="noSurat" class="mono" autocomplete="off">
                <span class="chk"><input type="checkbox" id="samaSurat" checked> sama dengan Nomor PLN</span>
              </label>
              <label class="f"><span class="req">Tgl surat permohonan</span>
                <input type="date" id="tglSurat">
              </label>
            </div>
            <div class="row-half">
              <label class="f"><span class="req">No. BA survei</span>
                <input type="text" id="noBa" class="mono" autocomplete="off">
                <span class="chk"><input type="checkbox" id="samaBa" checked> sama dengan Nomor PLN</span>
              </label>
              <label class="f"><span class="req">Tgl BA survei</span>
                <input type="date" id="tglBa">
                <span class="chk"><input type="checkbox" id="samaTglBa" checked> sama dengan tgl surat</span>
              </label>
            </div>
            <label class="f">Tanggal penandatanganan <span class="hint">Kosongkan bila akan ditulis tangan; hari terisi otomatis</span>
              <input type="date" id="tglTtd">
            </label>
          </fieldset>
         </div>

         <div class="pane" id="pane-not" role="tabpanel" aria-labelledby="tab-not" hidden>
          <p class="auto">Otomatis dari tab Perjanjian: nama pelanggan, no. telepon, nomor permohonan.</p>
          <fieldset>
            <legend>1. Identitas</legend>
            <div class="row-half">
              <label class="f">Hari / tanggal pembahasan
                <input type="date" id="nTgl">
              </label>
              <label class="f">Unit PLN
                <input type="text" id="nUnit" autocomplete="off" data-keep>
              </label>
            </div>
            <label class="f">Lokasi pekerjaan
              <input type="text" id="nLokasi" autocomplete="off">
              <span class="chk"><input type="checkbox" id="samaLokasi" checked> sama dengan alamat pemohon</span>
            </label>
            <label class="f">Pekerjaan PPK <span class="hint">Juga mengisi angka 2 di BA Kesepakatan</span>
              <input type="text" id="nPekerjaan" autocomplete="off" placeholder="mis. Penggeseran tiang TM">
            </label>
            <div class="row-half">
              <label class="f">Petugas PLN
                <input type="text" id="nPetugas" autocomplete="off" data-keep>
              </label>
              <label class="f">Jabatan petugas
                <input type="text" id="nJabatan" autocomplete="off" data-keep>
              </label>
            </div>
          </fieldset>
          <fieldset>
            <legend>2. Rincian biaya (Rp)</legend>
            <label class="f">Total biaya PPK (Nilai RAB) <span class="hint">Terisi otomatis dari data PPK saat No Keluhan dipilih</span>
              <input type="text" id="nRab" class="mono money" inputmode="numeric" autocomplete="off" placeholder="0">
            </label>
            <p class="note" id="nTerbilang"></p>
            <p class="rab-hint" id="rabHint" hidden></p>
            <div class="row-half">
              <label class="f">Biaya material <span class="hint">Opsional</span>
                <input type="text" id="nMaterial" class="mono money" inputmode="numeric" autocomplete="off" placeholder="0">
              </label>
              <label class="f">Biaya jasa <span class="hint">Otomatis = total − material</span>
                <input type="text" id="nJasa" class="mono money" inputmode="numeric" autocomplete="off" placeholder="0">
              </label>
            </div>
            <p class="rab-hint" id="splitHint" hidden></p>
          </fieldset>
          <fieldset>
            <legend>3. Pembahasan</legend>
            <div class="checks" id="checks"></div>
          </fieldset>
          <fieldset>
            <legend>5. Kesimpulan</legend>
            <div class="seg" role="radiogroup" aria-label="Kesimpulan">
              <label><input type="radio" name="kes" value="setuju" checked> Setuju</label>
              <label><input type="radio" name="kes" value="belum"> Belum menyetujui</label>
              <label><input type="radio" name="kes" value=""> Kosongkan</label>
            </div>
            <label class="f" id="wrapKeberatan" hidden>Keberatan pelanggan <span class="hint">Maks. 2 baris</span>
              <textarea id="nKeberatan" rows="2"></textarea>
            </label>
            <label class="f">4. Catatan / masukan pelanggan <span class="hint">Maks. 3 baris</span>
              <textarea id="nCatatan" rows="2"></textarea>
            </label>
            <label class="f">Jabatan pelanggan <span class="hint">Bagian 6, opsional</span>
              <input type="text" id="nJabPel" autocomplete="off">
            </label>
          </fieldset>
         </div>

         <div class="pane" id="pane-bak" role="tabpanel" aria-labelledby="tab-bak" hidden>
          <p class="auto">Otomatis: nama &amp; alamat pemohon, tanggal dan nomor BA survei, pekerjaan, serta total biaya + terbilang dari tab Notulen.</p>
          <fieldset>
            <legend>Nomor &amp; tempat</legend>
            <label class="f">Nomor BA Kesepakatan <span class="hint">Juga mengisi poin (e) di Perjanjian</span>
              <input type="text" id="bNomor" class="mono" autocomplete="off">
            </label>
            <div class="row-half">
              <label class="f">Tanggal BA
                <input type="date" id="bTgl">
                <span class="chk"><input type="checkbox" id="samaTglB" checked> sama dengan tgl Notulen</span>
              </label>
              <label class="f">Bertempat di
                <input type="text" id="bTempat" autocomplete="off" data-keep>
              </label>
            </div>
          </fieldset>
          <fieldset>
            <legend>Pihak pertama (PLN)</legend>
            <label class="f">Nama / jabatan <span class="hint">Nama sebelum tanda "/" dipakai di kolom tanda tangan</span>
              <input type="text" id="bNamaPln" autocomplete="off" data-keep>
            </label>
            <div class="row-half">
              <label class="f">Unit
                <input type="text" id="bUnit" autocomplete="off" data-keep>
              </label>
              <label class="f">Alamat
                <input type="text" id="bAlamatPln" autocomplete="off" data-keep>
              </label>
