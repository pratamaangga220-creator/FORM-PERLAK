function isoDate(s){
  s=String(s||"").trim(); if(!s) return "";
  let m=s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})$/);
  if(m) return m[3]+"-"+m[2].padStart(2,"0")+"-"+m[1].padStart(2,"0");
  m=s.match(/^(\d{4})-(\d{2})-(\d{2})/); if(m) return m[0];
  if(/^\d{5}$/.test(s)){ const d=new Date(Date.UTC(1899,11,30)+Number(s)*864e5); return d.toISOString().slice(0,10); }
  return "";
}
const KEEP_UP=new Set(["PT","CV","UD","TB","RT","RW","BR","GG","JL","SD","SMP","SMA","KSU","LPD","BPD","BRI","BNI","II","III","IV","VI","VII"]);
function niceName(s){ return String(s).toLowerCase().split(/(\s+)/).map(w=>{ const u=w.toUpperCase().replace(/[.,]/g,""); if(KEEP_UP.has(u)) return w.toUpperCase(); return w.replace(/^(\p{L})/u,c=>c.toUpperCase()); }).join(""); }
function splitSapaan(raw){
  let nm=String(raw||"").trim(), sap=null;
  const m=nm.match(/^(BAPAK|BPK\.?|BP\.?|PAK|IBU|BU|SDR\.?|SAUDARA|SDRI\.?)\s+/i);
  if(m){ const t=m[1].toUpperCase().replace(".",""); sap=/^(IBU|BU|SDRI)$/.test(t)?"Ibu":/^(SDR|SAUDARA)$/.test(t)?"Saudara":"Bapak"; nm=nm.slice(m[0].length); }
  else if(/^(PT|CV|UD|KANTOR|HOTEL|VILLA|VILA|YAYASAN|PURA|BANJAR|DESA|KOPERASI|LPD|SEKOLAH|RESTO|RESTORAN)\b/i.test(nm)) sap="";
  return {sap, nama:niceName(nm)};
}
function telp(s){ let d=String(s||"").replace(/\D/g,""); if(d.startsWith("62")) d="0"+d.slice(2); else if(d.startsWith("8")) d="0"+d; return d; }
function rabOf(r){ const d=String(r["Nilai RAB"]||"").replace(/[^\d]/g,""); if(!d) return null; const n=Number(d); return n>1e10?{bad:true,raw:r["Nilai RAB"]}:{n}; }
function setVal(id,v){ $(id).value=v; }
// Ambil nama jalan saja dari alamat panjang di data PPK.
// "JL TUKAD SELATAN NO 2 BANJAR WIJAYA KUSUMA KEL UNGASAN KEC ..." -> "Jl Tukad Selatan No. 2"
const ADDR_STOPW=new Set(["BANJAR","BR","LINGKUNGAN","LINGK","LINK","LING","KEL","KELURAHAN","DESA","DS","KEC","KECAMATAN","KAB","KABUPATEN","PROV","PROVINSI","PRV","ACUAN","LOKASI","SETEMPAT","DEKAT","DEPAN","DPN","BELAKANG","SEBELAH","SAMPING","SEBRANG","SEBERANG","PERUM","PERUMAHAN","MASUK","KOTA","KEL/DESA","DISAMPING","KAV"]);
const ROMAN=/^(?=[IVX])X{0,3}(?:IX|IV|V?I{0,3})$/;
function isStreetWord(u,i){ return u==="JL"||u==="JLN"||u==="JALAN"||(i===0&&u==="ALAN"); }
function cap(w){ return w.split("-").map(p=>p? p.charAt(0).toUpperCase()+p.slice(1).toLowerCase():p).join("-"); }
function shortAddress(raw){
  let s=String(raw||"").replace(/\s+/g," ").trim(); if(!s) return "";
  s=s.replace(/,(?=\S)/g,", ").replace(/\b(JL|JLN|GG)\.(?=\S)/gi,"$1. ").replace(/\b(NO)\.(?=\d)/gi,"NO. ");
  let w=s.split(" ");
  const key=x=>x.toUpperCase().replace(/[.,:;\-]+$/,"");
  // mulai dari kata "Jl"/"Jalan" pertama; kalau tidak ada, dari "Gg" di awal alamat
  let st=w.findIndex((x,i)=>isStreetWord(key(x),i));
  if(st<0){ const g=w.findIndex((x,i)=>i<3&&(key(x)==="GG"||key(x)==="GANG")); if(g>=0) st=g; }
  if(st>0) w=w.slice(st);
  const out=[]; let afterNo=0;
  for(let i=0;i<w.length;i++){
    let x=w[i]; const u=key(x);
    if(afterNo===2) break;                                                        // berhenti setelah nomor rumah
    if(!u){ if(/^-+$/.test(x)&&out.length>1) break; continue; }
    if(u==="-"||u==="/"||u==="//"||u.startsWith("(")) { if(out.length>1) break; else continue; }
    if(/^R[TW]([\W\d]|$)/.test(u)||u==="RTRW") break;
    if(ADDR_STOPW.has(u)){ if(out.length===0) continue; if(out.length===1&&/^(JL|GG)$/.test(key(out[0]))&&(u==="PERUM"||u==="PERUMAHAN")){ out.length=0; continue; } break; }
    if(isStreetWord(u,1)){
      const hasStreet=out.some(o=>isStreetWord(key(o),1));
      if(out.length && key(out[out.length-1])==="JL") continue;                 // "JL JL. TAMAN"
      if(!hasStreet && out.length){ out.length=0; afterNo=0; }                   // "PERUM PKC JL PERDANA" -> mulai dari Jl
      else if(hasStreet && out.length>1) break;                                  // jalan kedua: berhenti
    }
    if(u==="NO"){ if(/-$/.test(x)) break; afterNo=1; out.push("No."); continue; }
    if(/^NO\.?\d/.test(u)){ out.push("No."); x=x.replace(/^NO\.?/i,""); afterNo=1; }
    if(afterNo===1 && out[out.length-1]==="No."){ out.push(x.replace(/[.,;:(]+$/,"")); afterNo=2; if(/[,;(]$/.test(x)) break; continue; }
    x=x.replace(/\(.*$/,"");
    const endPunct=/[,;]$/.test(x)||(/\.$/.test(x)&&u.length>3&&!/^(JL|JLN|GG|NO|BLK|BLOK)$/.test(u));
    out.push(x.replace(/[.,;:]+$/,""));
    if(endPunct && out.length>1) break;
  }
  // buang "No." tanpa nomor yang jelas (kosong, "-", "0", "00", "0 0")
  while(out.length && /^(No\.|-|0+|-+)$/.test(out[out.length-1])){ const last=out.pop(); if(last==="No.") break; if(out[out.length-1]==="No."){ out.pop(); break; } }
  let r=out.map(x=>{ const u=x.toUpperCase();
    if(u==="JL"||u==="JLN"||u==="JALAN"||u==="ALAN") return "Jl";
    if(u==="GG"||u==="GANG") return "Gg";
    if(x==="No.") return x;
    if(ROMAN.test(u)) return u;
    if(/\d/.test(x)) return u;
    return cap(x); }).join(" ").replace(/\s+/g," ").trim();
  if(r.length>55){ r=r.slice(0,55); r=r.slice(0,r.lastIndexOf(" ")); }
  return r || String(raw).trim().split(" ").slice(0,6).join(" ");
}

function applyRecord(r){
  if(!r) return;
  picked=r; $("lkList").hidden=true; $("q").value=r["No Laporan"]||"";
  const s=splitSapaan(r["Nama Pemohon"]);
  if(s.sap!==null) setVal("sapaan",s.sap);
  setVal("nama",s.nama); setVal("alamat",shortAddress(r["Alamat"])); setVal("telp",telp(r["Kontak Pemohon"]));
  setVal("noPln",r["No Laporan"]||""); $("samaSurat").checked=true; $("samaBa").checked=true;
  const tp=isoDate(r["Tanggal Permohonan"]), ts=isoDate(r["Tanggal Survei"]);
  setVal("tglSurat",tp);
  if(ts&&ts!==tp){ $("samaTglBa").checked=false; setVal("tglBa",ts); } else { $("samaTglBa").checked=true; }
  $("samaLokasi").checked=true;
  const pek=r["Catatan Survei"]||r["Uraian Permohonan"]||""; if(pek) setVal("nPekerjaan",pek);
  const tr=isoDate(r["Tgl Pembahasan RAB"]); if(tr) setVal("nTgl",tr);
  const rb=rabOf(r); setVal("nRab", rb&&!rb.bad? rp(rb.n) : ""); setVal("nMaterial",""); setVal("nJasa",""); jasaAuto=true;
  syncSame(); updTotal(); renderCard(r, s.sap===null); markStale();
  showTab("tab-pks");
}
function renderCard(r,sapUnknown){
  const rab=rabOf(r), jenis=r["Jenis PPK"]||"-", st=r["Status"]||"-";
  const skip=/^(APP|Kabel SR)$/i.test(jenis);
  const rows=[["No Urut",r["No Urut"]],["Jenis PPK",jenis],["Pelanggan",[r["Pelanggan/Non Pelanggan"],r["ID Pelanggan"]].filter(Boolean).join(" · ")],["Alamat lengkap",r["Alamat"]],["Tgl permohonan",r["Tanggal Permohonan"]],["Survei",[r["Tanggal Survei"],r["Petugas Survei"]].filter(Boolean).join(" · ")],["Catatan survei",r["Catatan Survei"]],["Nilai RAB",rab? (rab.bad?"⚠ "+r["Nilai RAB"]:"Rp "+rp(rab.n)):""],["Status SLA",r["Status SLA"]],["Keterangan",r["Catatan/Keterangan Umum"]]].filter(x=>x[1]);
  const warns=[];
  if(st==="Batal") warns.push("Permohonan ini berstatus Batal.");
  if(skip) warns.push("Jenis "+jenis+": tahap pembahasan (Notulen & BA Kesepakatan) boleh dilewati.");
  if(rab&&rab.bad) warns.push("Nilai RAB di spreadsheet tidak wajar (kemungkinan terisi No Register). Isi biaya manual.");
  if(sapUnknown) warns.push("Sapaan tidak tercantum di nama; cek pilihan Bapak/Ibu.");
  const c=$("lkCard");
  c.innerHTML='<div class="top"><b>'+esc(r["Nama Pemohon"]||"")+'</b><span class="chip '+(st==="Batal"?"bad":st==="Selesai"?"ok":"")+'">'+esc(st)+'</span></div>'+
    '<dl>'+rows.map(([a,b])=>'<dt>'+esc(a)+'</dt><dd>'+esc(b)+'</dd>').join("")+'</dl>'+
    warns.map(w=>'<p class="lk-warn">'+esc(w)+'</p>').join("");
  c.hidden=false;
  updRabHint();
}
function updRabHint(){
  const el=$("rabHint"); if(!el) return;
  const rab=picked&&rabOf(picked);
  if(!rab||rab.bad){ el.hidden=true; return; }
  const t=num("nRab");
  el.hidden=false;
  if(!t){ el.className="rab-hint warn"; el.textContent="Nilai RAB di data PPK: Rp "+rp(rab.n)+" (kolom total masih kosong)."; }
  else if(t!==rab.n){ el.className="rab-hint warn"; el.textContent="Total diubah dari Nilai RAB di data PPK (Rp "+rp(rab.n)+")."; }
  else { el.className="rab-hint"; el.textContent="Sesuai Nilai RAB di data PPK."; }
}


(async function init(){
  const c=window.claude;
  if(LOCAL){
    logRows=localRows(); renderLog(); $("logNote").hidden=false;
    $("btnSrc").textContent="Pilih file"; $("btnSet").hidden=false;
    if(remoteOn()){ lkStatus("Terhubung ke Google Sheets lewat Web App. Ketik No Keluhan atau nama.","ok"); return; }
    try{ const s=JSON.parse(localStorage.getItem("pks_ppk")||"null"); if(s&&s.recs&&s.recs.length) setData(s.recs,s.name+" (tersimpan)"); else { lkStatus("Klik ⚙ lalu isi kode akses untuk mencari langsung di Google Sheets, atau Pilih file Excel/CSV data PPK."); } }catch(e){ lkStatus("Pilih file Excel/CSV data PPK."); }
    return;
  }
  try{ mcp=await c.use("mcp"); }catch(e){ mcp=null; }
  if(mcp) lkStatus("Klik kotak pencarian atau Muat data untuk mengambil data PPK dari Google Sheets.");
  else { lkStatus("Data PPK tidak tersedia di tampilan ini (perlu claude.ai dengan Google Drive terhubung).","bad"); $("btnSrc").disabled=true; }
  try{ downloads=await c.use("downloads"); }catch(e){ downloads=null; }
  try{ user=await c.use("user"); }catch(e){ user=null; }
  try{ db=await c.use("db"); }catch(e){ db=null; }
  if(current){ markStale(); }
  if(!db){ $("logBody").innerHTML='<tr><td colspan="15" class="wrapc" style="color:var(--muted)">Riwayat tidak bisa dimuat di tampilan ini (perlu masuk ke claude.ai).</td></tr>'; return; }
  db.collection("riwayat").orderBy("waktu","desc").limit(1000).onSnapshot(snap=>{
    logRows=snap.docs.map(d=>d.data()); renderLog();
  },err=>{ $("logBody").innerHTML='<tr><td colspan="15" class="wrapc" style="color:var(--muted)">Riwayat tidak bisa dimuat ('+esc(err&&err.code||"error")+').</td></tr>'; });
})();

window.__pks={buildPdf:()=>current&&buildPdf(current.pages),fill:fillDocx,values};
})();
