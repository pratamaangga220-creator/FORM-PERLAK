// ---- uang & terbilang
function digits(s){ return String(s||"").replace(/\D/g,""); }
function num(id){ const d=digits($(id).value); return d?Number(d):0; }
function rp(n){ return Number(n).toLocaleString("id-ID"); }
function tb(n){
  const s=["","satu","dua","tiga","empat","lima","enam","tujuh","delapan","sembilan","sepuluh","sebelas"];
  n=Math.floor(n);
  if(n<12) return s[n];
  if(n<20) return tb(n-10)+" belas";
  if(n<100) return tb(Math.floor(n/10))+" puluh "+tb(n%10);
  if(n<200) return "seratus "+tb(n-100);
  if(n<1000) return tb(Math.floor(n/100))+" ratus "+tb(n%100);
  if(n<2000) return "seribu "+tb(n-1000);
  if(n<1e6) return tb(Math.floor(n/1000))+" ribu "+tb(n%1000);
  if(n<1e9) return tb(Math.floor(n/1e6))+" juta "+tb(n%1e6);
  if(n<1e12) return tb(Math.floor(n/1e9))+" miliar "+tb(n%1e9);
  return tb(Math.floor(n/1e12))+" triliun "+tb(n%1e12);
}
function terbilangRp(n){ const t=(n?tb(n):"nol").replace(/\s+/g," ").trim(); return t.replace(/\b\w/g,c=>c.toUpperCase())+" Rupiah"; }
// Total = Nilai RAB bila diisi; jika kosong, total = material + jasa.
