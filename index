const INK="#111";
function FN(size,bold,italic){ return (italic?"italic ":"")+(bold?"700 ":"400 ")+size+"px Arimo, Arial, sans-serif"; }
function put(g,t,x,y,o){ o=o||{}; if(!t) return; g.save(); g.font=FN(o.size||16,o.bold,o.italic); g.fillStyle=INK; g.textAlign=o.align||"left"; g.textBaseline="alphabetic"; if(o.maxW) g.fillText(String(t),x,y,o.maxW); else g.fillText(String(t),x,y); g.restore(); }
function white(g,x,y,w,h){ g.save(); g.fillStyle="#fff"; g.fillRect(x,y,w,h); g.restore(); }
function wrapLines(g,text,maxW){ const out=[]; String(text).split(/\n/).forEach(par=>{ const words=par.split(/\s+/).filter(Boolean); let cur=""; words.forEach(w=>{ const t=cur?cur+" "+w:w; if(!cur||g.measureText(t).width<=maxW) cur=t; else { out.push(cur); cur=w; } }); if(cur) out.push(cur); }); return out; }
function line1(g,text,x,y,maxW,sizes,o){ o=o||{}; let sz=sizes[sizes.length-1]; for(const s of sizes){ g.font=FN(s,o.bold,o.italic); if(g.measureText(text).width<=maxW){ sz=s; break; } } put(g,text,x,y,{size:sz,bold:o.bold,italic:o.italic,maxW}); }
function block(g,text,x,y0,maxW,lineH,maxLines,sizes,o){
  o=o||{}; let ls=[], sz=sizes[sizes.length-1];
  for(const s of sizes){ g.font=FN(s,o.bold); ls=wrapLines(g,text,maxW); sz=s; if(ls.length<=maxLines) break; }
  ls.slice(0,maxLines).forEach((l,i)=>{
    const last=i===Math.min(ls.length,maxLines)-1;
    if(o.justify && !last) justify(g,l,x,y0+i*lineH,maxW,sz);
    else put(g,l,x,y0+i*lineH,{size:sz,bold:o.bold,maxW});
  });
}
function justify(g,line,x,y,maxW,sz){
  g.save(); g.font=FN(sz); g.fillStyle=INK; const ws=line.split(" ");
  const tw=ws.reduce((a,w)=>a+g.measureText(w).width,0); const gap=(maxW-tw)/Math.max(1,ws.length-1);
  if(ws.length<2||gap>sz*1.6){ g.fillText(line,x,y); g.restore(); return; }
  let cx=x; ws.forEach(w=>{ g.fillText(w,cx,y); cx+=g.measureText(w).width+gap; }); g.restore();
}
function tick(g,cx,cy){ g.save(); g.strokeStyle=INK; g.lineWidth=2.8; g.lineCap="round"; g.lineJoin="round"; g.beginPath(); g.moveTo(cx-6,cy); g.lineTo(cx-1.5,cy+5); g.lineTo(cx+7,cy-7); g.stroke(); g.restore(); }

// Lampiran II-A: Notulen Pembahasan RAB (gambar 1086 x 1448 px)
function drawNotulen(g,L){
  // Isian kotak identitas: satu baris bila muat, kalau panjang turun ke dua baris lebih kecil.
  const cell=(t,x,cy)=>{
    if(!t) return; t=String(t).replace(/\s+/g," ").trim(); const W=250;
    for(const sz of [15,14,13]){ g.font=FN(sz); if(g.measureText(t).width<=W){ put(g,t,x,cy+5,{size:sz}); return; } }
    const fit=[[12,2],[11,2],[10,3],[9,3]];
    for(let i=0;i<fit.length;i++){ const [sz,max]=fit[i]; g.font=FN(sz); let ls=wrapLines(g,t,W); const last=i===fit.length-1;
      if(ls.length<=max||last){ if(ls.length>max) ls=ls.slice(0,max-1).concat([ls.slice(max-1).join(" ")]); const lh=sz+1.5, y0=cy-(ls.length-1)*lh/2+4;
        ls.forEach((l,k)=>put(g,l,x,y0+k*lh,{size:sz,maxW:W})); return; } }
  };
  cell(L.nTgl,278,152); cell(L.nLokasi,278,188); cell(L.nama,278,224); cell(L.telp,278,263);
  cell(L.noPln,790,152); cell(L.nUnit,790,188); cell(L.nPetugas,790,224); cell(L.nPekerjaan,790,263);
  if(L.material) put(g,rp(L.material),595,395,{size:17});
  if(L.jasa) put(g,rp(L.jasa),595,434,{size:17});
  if(L.total) put(g,rp(L.total),595,475,{size:17,bold:true});
  if(L.material) put(g,rp(L.material),582,637,{size:14,align:"center",maxW:126});
  if(L.jasa) put(g,rp(L.jasa),549,675,{size:14,align:"center",maxW:116});
  if(L.total&&L.kes!=="belum") put(g,rp(L.total),677,846,{size:13,align:"center",maxW:104});
  const X={ya:893,tidak:994}, Y={A1:597,A2:635,A3:672,A4:710,B1:747,B2:795};
  Object.keys(Y).forEach(k=>{ const c=L.checks[k]; if(c&&X[c]) tick(g,X[c],Y[k]); });
  if(L.kes==="setuju"){ tick(g,X.ya,866); tick(g,X.tidak,952); tick(g,60,1180); }
  if(L.kes==="belum"){ tick(g,X.tidak,866); tick(g,X.ya,952); tick(g,60,1206); }
  if(L.keberatan){ g.font=FN(14); wrapLines(g,L.keberatan,540).slice(0,2).forEach((l,i)=>put(g,l,286,966+i*25,{size:14,maxW:540})); }
  if(L.catatan){ g.font=FN(13); wrapLines(g,L.catatan,960).slice(0,3).forEach((l,i)=>put(g,l,55,1068+i*20,{size:13,maxW:960})); }
  put(g,L.nPetugas,205,1336,{size:13,maxW:262}); put(g,L.nJabatan,205,1353,{size:13,maxW:262});
  put(g,L.nama,707,1336,{size:13,maxW:262}); put(g,L.nJabPel,707,1353,{size:13,maxW:262});
  put(g,L.nPetugas,336,1385,{size:12,align:"center",maxW:240}); put(g,L.nama,838,1385,{size:12,align:"center",maxW:240});
}
