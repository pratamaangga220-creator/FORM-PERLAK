  box.innerHTML=items.length? items.map((r,i)=>'<li role="option" id="lk'+i+'" aria-selected="'+(i===lkSel)+'" data-i="'+i+'"><span class="l1">'+esc(r["No Laporan"])+' · No '+esc(r["No Urut"]||"-")+'</span><span class="l2">'+esc(r["Nama Pemohon"])+'</span><span class="l3">'+esc([r["Jenis PPK"],r["Status"],r["Tanggal Permohonan"]].filter(Boolean).join(" · "))+'</span></li>').join("")
    : '<li aria-disabled="true"><span class="l3">Tidak ada data dengan No Keluhan atau nama itu.</span></li>';
  box.hidden=false;
}
$("q").addEventListener("input",()=>{ if(!remoteOn()) return; clearTimeout(rTimer); rTimer=setTimeout(remoteSearch,450); });
