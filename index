    let rows;
    if(/\.csv$/i.test(file.name)) rows=parseCSV(await file.text());
    else {
      const wb=XLSX.read(await file.arrayBuffer(),{type:"array"});
      const ws=wb.Sheets["Data_PPK"]||wb.Sheets[wb.SheetNames[0]];
      rows=XLSX.utils.sheet_to_json(ws,{header:1,raw:false,defval:""});
    }
    const recs=toRecords(rows); remote=null; try{ localStorage.removeItem("pks_ppk_remote"); }catch(e){} setData(recs,file.name);
    try{ localStorage.setItem("pks_ppk",JSON.stringify({name:file.name,recs})); }catch(e){}
  }catch(e){ lkStatus("File tidak bisa dibaca: "+(e.message||e)+". Gunakan file Excel/CSV hasil download sheet Data_PPK.","bad"); }
}
function search(){
  if(remoteOn()) return;
  const q=$("q").value.trim(); const box=$("lkList");
  if(!ppk||!q){ box.hidden=true; lkItems=[]; return; }
  const k=normKey(q), n=q.toUpperCase();
  lkItems=ppk.filter(r=>r.__k.includes(k)||r.__n.includes(n)).sort((a,b)=>(b.__k===k)-(a.__k===k)).slice(0,12);
  lkSel=lkItems.length?0:-1;
  box.innerHTML=lkItems.length? lkItems.map((r,i)=>'<li role="option" id="lk'+i+'" aria-selected="'+(i===lkSel)+'" data-i="'+i+'"><span class="l1">'+esc(r["No Laporan"])+' · No '+esc(r["No Urut"]||"-")+'</span><span class="l2">'+esc(r["Nama Pemohon"])+'</span><span class="l3">'+esc([r["Jenis PPK"],r["Status"],r["Tanggal Permohonan"]].filter(Boolean).join(" · "))+'</span></li>').join("")
    : '<li aria-disabled="true"><span class="l3">Tidak ada data dengan No Keluhan atau nama itu.</span></li>';
  box.hidden=false;
}
function markSel(){ [...$("lkList").children].forEach((li,i)=>li.setAttribute("aria-selected",i===lkSel?"true":"false")); }
$("q").addEventListener("input",search);
$("q").addEventListener("focus",()=>{ if(!ppk&&!LOCAL&&mcp) loadFromDrive(); else if($("q").value.trim()) search(); });
$("q").addEventListener("keydown",e=>{
  if(e.key==="ArrowDown"&&lkItems.length){ lkSel=Math.min(lkItems.length-1,lkSel+1); markSel(); e.preventDefault(); }
  else if(e.key==="ArrowUp"&&lkItems.length){ lkSel=Math.max(0,lkSel-1); markSel(); e.preventDefault(); }
  else if(e.key==="Enter"){ e.preventDefault(); if(lkSel>=0&&lkItems[lkSel]) applyRecord(lkItems[lkSel]); }
  else if(e.key==="Escape"){ $("lkList").hidden=true; }
});
$("lkList").addEventListener("click",e=>{ const li=e.target.closest("li[data-i]"); if(li) applyRecord(lkItems[+li.dataset.i]); });
$("btnSrc").addEventListener("click",()=>{ if(LOCAL) $("fileSrc").click(); else loadFromDrive(); });
