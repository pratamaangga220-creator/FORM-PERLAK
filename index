});
try{ const t=localStorage.getItem("pks_tab"); if(t&&$(t)) showTab(t); }catch(e){}

// ---- pembahasan checklist
const CHECKS=[["A1","Ruang lingkup pekerjaan PPK telah dijelaskan"],["A2","Rincian biaya material telah dijelaskan"],["A3","Rincian biaya jasa telah dijelaskan"],["A4","Dasar penyusunan RAB telah dijelaskan"],["B1","Pelanggan diberi kesempatan bertanya"],["B2","Pelanggan memahami penjelasan biaya"]];
